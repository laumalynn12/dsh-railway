# Set before first deploy — otherwise a random password is printed to deploy logs.
ADMIN_PASSWORD=

# Optional: pin a specific @deepseek-ai/dsh release (build arg). Defaults to the
# version baked into the Dockerfile. Developer preview upstream — expect breaking
# changes between versions, so pin explicitly for anything long-lived.
# DSH_VERSION=0.1.1-rc.2

# Optional: proxy login username. Default: admin
# ADMIN_USERNAME=admin
